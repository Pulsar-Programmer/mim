{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIM",
  "version": "0.1.4",
  "identifier": "com.maze.mim",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MIM",
        "width": 1120,
        "height": 740,
        "minWidth": 860,
        "minHeight": 580,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1QjBCOEI3MzIyMTA5NTkKUldSWkNTRXl0N2l3Rlk4SWVBeE5yK0pFMHhMbDJyc0JUVVJJSlhDN2ViSlJiUVZnbnpDUE0vTWsK",
      "endpoints": [
        "https://github.com/Pulsar-Programmer/mim/releases/latest/download/latest.json"
      ]
    }
  }
}
